<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  deckhand server as a user LaunchAgent. KeepAlive restarts it after a crash,
  a logout, or a wake-from-sleep that killed it — the thing a hand-started
  `deckhand serve` does NOT survive. Generated from this template by
  ops/install-services.sh (placeholders __LIKE_THIS__ are filled at install).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>no.deckhand.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--import</string>
    <string>tsx</string>
    <string>server/src/cli.ts</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- A LaunchAgent gets none of the user's shell PATH, so every build tool
         must be named here. CocoaPods in particular lives in a Ruby gem bin dir
         (homebrew ruby, rbenv, ...) that is NOT /opt/homebrew/bin: without it
         `ns run ios` reaches "Installing pods..." and exits 127. The installer
         resolves pod/adb/emulator on the installing machine. -->
    <key>PATH</key>
    <string>__PATH__</string>
    <!-- Ruby tooling (CocoaPods) treats paths as ASCII-8BIT without a UTF-8
         locale and `pod install` fails on unicode normalization. launchd gives
         an agent no locale at all. -->
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/server.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/server.log</string>
</dict>
</plist>
