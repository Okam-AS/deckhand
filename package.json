{
  "name": "deckhand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server on a Mac mini that boots simulators for any branch/PR and returns a live, controllable browser link",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "viewer",
    "landing"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "tsx --test scripts/review-receipt.test.ts scripts/hooks/bash-guard.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/tsconfig.json",
    "review:check": "tsx scripts/review-receipt.ts check",
    "review:hash": "tsx scripts/review-receipt.ts hash",
    "review:show": "tsx scripts/review-receipt.ts show",
    "review:round": "tsx scripts/review-receipt.ts round",
    "review:gates": "tsx scripts/review-receipt.ts gates",
    "review:gates:quick": "tsx scripts/review-receipt.ts gates:quick",
    "review:handover": "tsx scripts/review-receipt.ts handover",
    "build": "npm run build --workspace @deckhand/viewer && npm run build --workspace @deckhand/landing -- --outDir ../dist && node landing/scripts/prepare-hosting.mjs",
    "dev": "npm run dev --workspace @deckhand/server",
    "postinstall": "patch-package",
    "test:device": "npm run --workspace @deckhand/server test:device",
    "hooks:install": "ln -sf ../../ops/hooks/pre-commit .git/hooks/pre-commit && echo 'pre-commit hook installed'",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
